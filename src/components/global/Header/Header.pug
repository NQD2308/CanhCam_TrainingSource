header(class="w-full")
	.bottom(class="w-full")
		nav(class="bg-white border-gray-200 px-4 lg:px-6 py-2.5")
			.container(class="container mx-auto flex flex-wrap justify-between items-center")
				//- Logo
				a(href="#" class="flex items-center")
					.logo(class="flex items-center")
						img(src="img/Logo.png", alt="Logo", class="mr-3 h-[57px] object-contain")
										
				//- Menu
				.menu-2(class="hidden justify-between items-center w-full lg:flex lg:w-auto")
					.menu-item(class="menu-item")
						a(href="#" class="block py-2 pr-4 pl-3 text-primary-2 border-b border-primary-2 lg:border-0 md:text-sm lg:text-base") 
							<i class="fa-regular fa-house text-primary-2"></i>
					
					.menu-item(class="menu-item")
						a(href="#") Giới thiệu
					
					.menu-item(class="group inline-block px-4 py-2")
						a(class="w-fit outline-none focus:outline-none cursor-pointer px-3 py-1 rounded-sm flex items-center")
							span(class="pr-1 ") Sản phẩm
							<i class="fa-solid fa-caret-down ml-2"></i>
						ul(class="bg-white mt-1 rounded-sm transform scale-0 group-hover:scale-100 absolute transition duration-150 ease-in-out origin-top min-w-[200px] z-50")
							li(class="block w-full")
								a(href="#" class="block w-full py-4 px-4 text-white hover:bg-primary-2 md:text-sm lg:text-base") Sản phẩm 1
							li(class="block w-full")
								a(href="#" class="block w-full py-2 px-4 text-white hover:bg-primary-2 md:text-sm lg:text-base") Sản phẩm 2
							li(class="block w-full")
								a(href="#" class="block w-full py-2 px-4 text-white hover:bg-primary-2 md:text-sm lg:text-base") Sản phẩm 3
					
					.menu-item(class="menu-item")
						a(href="#") Công bố sản phẩm

					.menu-item(class="menu-item")
						a(href="#") Quy trình công nghệ
					
					.menu-item(class="menu-item")
						a(href="#") Chứng nhận	
					
					.menu-item(class="menu-item")
						a(href="#") Tin tức
				
				//- Other function
				.right-side(class="flex items-center")
					a.search-box(class="relative")
						<i class="fa-regular fa-magnifying-glass text-2xl cursor-pointer hover:text-primary-2 transition-all duration-300"></i>
						
					
					.language(class="flex items-center")
						a(href="#" class="text-gray-900 font-medium text-2x") VN
						<i class="fa-solid fa-caret-down "></i>

					a.contact(class="flex items-center" href="#")
						span(class="text-white font-medium") Liên hệ
						<i class="fa-light fa-arrow-up text-white text-2xl arrow-icon"></i>
						
