.banner-swiper(class="relative m-0 px-5 pt-10")
	.swiper.mySwiperBanner
		.swiper-wrapper
			.swiper-slide
				.wrapper-content
					img(src="/img/banner1.png", alt="", class=" object-cover rounded-3xl")
					.content(class="absolute top-1/2 hidden md:block left-60 w-full -translate-y-1/2 z-10")
						.title(class="") CÔNG NGHỆ SẤY THĂNG HOA TIÊN TIẾN
						.text(class="") GIỮ TRỌN HƯƠNG VỊ TỰ NHIÊN
						.btn-view-all(class="w-fit flex justify-center items-center")
							a.btn-view-all-in-carousel
								span(href="#" class="btn btn-primary") Tìm hiểu thêm
								i(class="fa-regular fa-arrow-up arrow-icon")
			.swiper-slide
				.wrapper-content
					img(src="/img/banner2.png", alt="", class="w-full h-[160px] md:h-[300px] lg:h-[780px] object-cover rounded-3xl aspect-[16/9]")
					.content(class="absolute top-1/2 hidden md:block left-60 w-full -translate-y-1/2 z-10")
						.title(class="text-neutral-White") CÔNG NGHỆ SẤY <br>THĂNG HOA TIÊN TIẾN
						.text(class="text-neutral-White") GIỮ TRỌN HƯƠNG VỊ TỰ NHIÊN
						.btn-view-all(class="w-fit flex justify-center items-center")
							a.btn-view-all-in-carousel
								span(href="#" class="btn btn-primary") Tìm hiểu thêm
								i(class="fa-regular fa-arrow-up arrow-icon")
			.swiper-slide
				.wrapper-content
					img(src="/img/banner3.png", alt="", class="w-full h-[160px] md:h-[300px] lg:h-[780px] object-cover rounded-3xl aspect-[16/9]")
					.content(class="absolute top-1/2 hidden md:block left-60 w-full -translate-y-1/2 z-10")
						.title(class="text-neutral-White") CÔNG NGHỆ SẤY <br>THĂNG HOA TIÊN TIẾN
						.text(class="text-neutral-White") GIỮ TRỌN HƯƠNG VỊ TỰ NHIÊN
						.btn-view-all(class="w-fit flex justify-center items-center")
							a.btn-view-all-in-carousel
								span(href="#" class="btn btn-primary") Tìm hiểu thêm
								i(class="fa-regular fa-arrow-up arrow-icon")
							
		.swiper-button-next(class="custom-swiper-button before:hidden md:mr-15 lg:mr-25 after:hidden bg-black opacity-50 rounded-full py-3 px-7 flex items-center justify-center")
			i(class="fa-light fa-chevron-right text-white text-28")
		.swiper-button-prev(class="custom-swiper-button before:hidden md:ml-15 lg:ml-25 after:hidden bg-black opacity-50 rounded-full py-3 px-7 flex items-center justify-center")
			i(class="fa-light fa-chevron-left text-white text-28")
		.swiper-pagination
	
script(src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js")

script.
	var swiper = new Swiper(".mySwiperBanner", {
		loop: true,
		navigation: {
			nextEl: ".swiper-button-next",
			prevEl: ".swiper-button-prev",
		},
		pagination: {
			el: ".swiper-pagination",
			clickable: true,
		},
	})