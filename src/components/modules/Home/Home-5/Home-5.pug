script. 
	document.addEventListener("DOMContentLoaded", () => {
		const buttons = document.querySelectorAll(".category-product");

		buttons.forEach(btn => {
			btn.addEventListener("click", (e) => {
				e.preventDefault();

				// Bỏ active khỏi tất cả li
				document.querySelectorAll(".categol-item ul li").forEach(li => li.classList.remove("active"));

				// Gán active vào li chứa nút vừa bấm
				btn.closest("li").classList.add("active");

				const type = btn.dataset.type;
				const posts = document.querySelectorAll(".cart-product");

				posts.forEach(post => {
					const category = post.dataset.category;
					post.style.display = (type === "all" || category === type) ? "block" : "none";
				});
			});
		});
	});



