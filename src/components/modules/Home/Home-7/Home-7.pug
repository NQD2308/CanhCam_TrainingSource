							span.tags(class="category-post") Tin hoạt động
							span.date(class="date-post") 04.03.2025
						.content-title(class="text-neutral-900 text-xl font-bold mt-2 overflow-hidden truncate whitespace-nowrap transition-all duration-500 ease-in-out") Làm thế nào để chọn thực phẩm chất lượng cho bữa ăn hàng ngày?
						.content-description(class="text-neutral-800 font-medium mt-2 line-clamp-2 overflow-hidden text-ellipsis") Lorem ipsum dolor sit amet, consectetur adipiscing elit. Nunc vulputate libero et velit interdum, ac aliquet odio mattis.

script. 
	document.addEventListener("DOMContentLoaded", () => {
		const buttons = document.querySelectorAll(".news-category-item");
		const posts = document.querySelectorAll(".cart-news");

		buttons.forEach(btn => {
			btn.addEventListener("click", (e) => {
				e.preventDefault();

				// Xóa class active cũ
				buttons.forEach(b => b.classList.remove("active"));
				btn.classList.add("active");

				const type = btn.dataset.type;

				posts.forEach(post => {
					const category = post.dataset.category;

					if (type === "all" || category === type) {
						post.style.display = "block";
					} else {
						post.style.display = "none";
					}
				});
			});
		});
	});


			
